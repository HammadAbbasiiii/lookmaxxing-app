# LookMaxx Web — backend environment
# Copy this file to `.env` and fill in real values. NEVER commit a real `.env`.

# ── AI plan generation (DeepSeek) ─────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-chat

# ── Database ─────────────────────────────────────────────────
# SQLite for local dev; Postgres URL in production (Render).
DATABASE_URL=

# ── Redis (optional; used for rate limiting in production) ────
REDIS_URL=

# ── Auth (JWT) ───────────────────────────────────────────────
SECRET_KEY=
ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=

# ── Password reset email ────────────────────────────────────
# EMAIL_PROVIDER: "console" (logs the link; dev/test) or "smtp".
# For production delivery set EMAIL_PROVIDER=smtp + the SMTP_* values below.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@lookmaxx.app
SMTP_FROM_NAME=LookMaxx
SMTP_USE_TLS=1
PASSWORD_RESET_EXPIRE_MINUTES=30

# ── Image storage (Cloudinary) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── ML model path ────────────────────────────────────────────
MODEL_PATH=
