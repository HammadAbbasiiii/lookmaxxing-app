# LookMaxx Web — backend environment
# Copy this file to `.env` and fill in real values. NEVER commit a real `.env`.

# ── App ──────────────────────────────────────────────────────
# "production" enables strict checks: a strong SECRET_KEY is required, test-mode
# Stripe events are rejected, and the CORS allow-list tightens to FRONTEND_URL.
# Use "development" locally.
ENVIRONMENT=development

# ── AI plan generation (DeepSeek) ─────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-chat

# ── Database ─────────────────────────────────────────────────
# SQLite for local dev (empty → falls back to sqlite:///./lookmaxx.db);
# Postgres URL in production (Render).
DATABASE_URL=

# ── Redis (optional; used for rate limiting in production) ────
REDIS_URL=
# Per-identity request limits (1-minute sliding window). Anonymous and
# authenticated users get separate buckets; 100/min per user is the default.
RATE_LIMIT_ANONYMOUS=60
RATE_LIMIT_AUTHENTICATED=100

# ── Auth (JWT) ───────────────────────────────────────────────
SECRET_KEY=
ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=

# ── CORS / frontend ──────────────────────────────────────────
# Where the web client lives (used for reset-link URLs + CORS allow-list).
FRONTEND_URL=http://localhost:3000
# Comma-separated extra allowed origins. Defaults to FRONTEND_URL + localhost.
CORS_ORIGINS=

# ── Password reset email ────────────────────────────────────
# EMAIL_PROVIDER: "console" (logs the link; dev/test) or "smtp".
# For production delivery set EMAIL_PROVIDER=smtp + the SMTP_* values below.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@lookmaxx.app
SMTP_FROM_NAME=LookMaxx
SMTP_USE_TLS=1
PASSWORD_RESET_EXPIRE_MINUTES=30

# ── Image storage (Cloudinary) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: upload preset included in the signed-upload signature.
CLOUDINARY_UPLOAD_PRESET=

# ── Payments (Stripe) ────────────────────────────────────────
# Leave STRIPE_SECRET_KEY blank to keep /payments/* in honest 503 mode.
# ⚠️  NEVER commit the secret key. The publishable key is safe to expose.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ELITE_MONTHLY=
STRIPE_PRICE_ELITE_ANNUAL=
# "£1 first month" (Pro monthly): Stripe coupon with duration=once and
# amount_off=899 (GBP pence) → first invoice £1.00. Leave blank to disable.
STRIPE_FIRST_MONTH_COUPON_ID=
# 7-day free trial on Elite (card collected up front).
STRIPE_ELITE_TRIAL_DAYS=7
# Dev/test-only: enables POST /payments/test-upgrade to preview Pro/Elite
# without a real charge. Ignored when ENVIRONMENT=production.
ALLOW_TEST_PAYMENTS=0

# ── Admin (comma-separated emails) ───────────────────────────
ADMIN_EMAILS=

# ── ML model path ────────────────────────────────────────────
# ── Affiliate links (product recommendations) ─────────────────
# Amazon Associates tag applied to every outbound product link.
# Set your real tag here; every product link inherits it automatically.
AMAZON_AFFILIATE_TAG=lookmaxx-20

MODEL_PATH=
